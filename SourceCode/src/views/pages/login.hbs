<head>
   <link rel="stylesheet" href="../resources/css/style.css">
</head>

<div class="rcc">
  <div class="rcc-wrap">
    <header class="rcc-top">
      <img src="../resources/img/logo.png" alt="Rock Creek Curling">
    </header>

    <div class="rcc-login">
         <section class="rcc-login-card">
            <h5>Login</h5>
               <form action="/login" method="POST">
                  <div class="rcc-field">
                     <label for="username">Username</label>
                     <input type="text" id="username" name="username" placeholder="Enter your username" required />
                  </div>
                  <div class="rcc-field">
                     <label for="password">Password</label>
                     <input type="text" id="password" name="password" placeholder="Enter your password" required />
                  </div>

                  <button type="submit" class="rcc-btn sm rcc-login-submit" onclick="location.href='/landing'" >Login </button>
               </form>
         <p class="rcc-register">
            Don't have an account?
            <a href="/register">Register</a>
         </p>
      </div>
    </section>

    <footer class="rcc-foot">
      <b>Rock Creek Curling</b>
      Lafayette, CO
    </footer>
  </div>
</div>