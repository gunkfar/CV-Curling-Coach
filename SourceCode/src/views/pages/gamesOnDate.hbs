
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Games on Date - Rock Creek Curling</title>
  <link rel="stylesheet" href="../resources/css/style.css">
</head>

<body>
  <div class="rcc">
    <div class="rcc-wrap">
       {{> header}}
      <main>
        <section class="rcc-sec">
          <h1>Games on Selected Date</h1>
          <p class="rcc-sub" id="selected-date"></p>
          
        <div class="game-time">
            <h2>6:00 PM</h2>
        
        {{#each leagues6}}
        <h3>{{this.league}}</h3> 
        {{!-- displays the league from the api query response --}}

        <div class="games-list">
          {{#each this.games}} 
          {{!-- accesses the games from the api query response --}}
            <p>
              Sheet {{this.sheet}}:
              {{this.team1}} vs {{this.team2}}
            {{!-- the games and the two teams from the api query response --}} 
            </p>
          {{/each}}
        </div>
        {{/each}}
        </div>

          <div class="game-time">
            <h2>8:15 PM</h2>
        
        {{#each leagues815}}
        <h3>{{this.league}}</h3> 
        {{!-- displays the league from the api query response --}}

        <div class="games-list">
          {{#each this.games}} 
          {{!-- accesses the games from the api query response --}}
            <p>
              Sheet {{this.sheet}}:
              {{this.team1}} vs {{this.team2}}
            {{!-- the games and the two teams from the api query response --}} 
            </p>
          {{/each}}
        </div>
        {{/each}}
        </div>

        </section>
      </main>

      <footer class="rcc-foot">
        <b>Rock Creek Curling</b>
        Lafayette, CO
      </footer>

    </div>
  </div>

<!--Code to display the date the user selected -->
  <script>
    const params = new URLSearchParams(window.location.search);
    const date = params.get("date");

    if (date) {
      document.getElementById("selected-date").textContent =
        "Selected date: " + date;
    }
  </script>
</body>
</html>
